{
  "manifest_version": 3,
  "name": "Threadveil",
  "version": "1.0",
  "description": "A quiet X/Twitter companion for hiding noisy replies with local filters.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.x.com/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["media-sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Threadveil"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
